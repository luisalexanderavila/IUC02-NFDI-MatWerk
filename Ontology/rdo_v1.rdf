<?xml version="1.0"?>
<rdf:RDF xmlns="https://purls.helmholtz-metadaten.de/rdo/"
     xml:base="https://purls.helmholtz-metadaten.de/rdo/"
     xmlns:co="https://w3id.org/pmd/co/"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:obo="http://purl.obolibrary.org/obo/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:emmo="http://emmo.info/emmo#"
     xmlns:prov="http://www.w3.org/ns/prov#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:oboInOwl="http://www.geneontology.org/formats/oboInOwl#"
     xmlns:ontology="http://nfdi.fiz-karlsruhe.de/ontology/">
 <owl:Ontology rdf:about="">
        <owl:versionIRI rdf:resource="https://purls.helmholtz-metadaten.de/rdo/1.0.0"/>
        <dc:contributor rdf:resource="https://orcid.org/0000-0001-9560-4728"/>
        <terms:created>2024-15-11</terms:created>
        <terms:creator rdf:resource="https://orcid.org/0000-0001-9560-4728"</terms:creator>
        <terms:description>The Reference Dataset Ontology describes general concepts, which are related to a reference dataset, including aspects of referencing, documentation and certification. The reference can be digital, bibliographical or material. The dataset can be related to any domain. This version encompasses datasets related to the domain of Material Science, and therefore also the concept of a reference material. The purpose of the Reference Dataset Ontology is to describe concepts, which are required to qualify a dataset as a reference dataset.</terms:description>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:title>The Reference Dataset Ontology </terms:title>
        <owl:versionInfo>1.0.0</owl:versionInfo>
    </owl:Ontology>
    

   
    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    <!-- https://purls.helmholtz-metadaten.de/rdo/ReferenceDataSet -->

    <owl:Class rdf:about="http://purls.helmholtz-metadaten.de/mwo/ReferenceDataSet">
     <owl:equivalentClass rdf:resource="https://www.niso.org/standards-committees/ssos/ssos01.owl#Reference"/>
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/rdo/DataSet"/>
        <obo:IAO_0000115 xml:lang="en">Reference data of materials are - documented according to certain standards as well as - curated (i.e., generated, maintained, preserved, validated) according to certain standards - quantitative data sets (i.e., data + their corresponding metadata) and - have been measured or simulated to a particularly high standard - for a material that has either experienced a well-documented process or is reference material or its composition and structure has been completely characterized. Reference data of materials can also be derived data from reference data. These data are distributed with a license (e.g., GPL) The here addressed standards for documentation, curation and measurement need to be defined for specific materials characteristics (e.g., creep tests) in terms of domain standards. These domain standards are the result of a steered community process. Standards should integrate as much as possible existing standards (e.g., the individual MatWerk domain standards should be as much as possible consistent).</obo:IAO_0000115>
        <rdfs:isDefinedBy>NFDI-MatWerk-IUC02</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Reference dataset</rdfs:label>
    </owl:Class>
    
    
  <!-- https://purls.helmholtz-metadaten.de/rdo/DataSet -->


    <owl:owl:Class rdf:about="https://purls.helmholtz-metadaten.de/rdo/ReferenceDataSet">
    <owl:equivalentClass rdf:resource="https://nfdi.fiz-karlsruhe.de/ontology/Dataset"/>
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/ontology/CreativeWork"/>
        <obo:IAO_0000115 xml:lang="en">A creative work that refers to a structured collection of data, organized typically for a specific goal such as analysis, research, or reference.</obo:IAO_0000115>
        <rdfs:comment xml:lang="en">A collection of data that consists of one or more files.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://nfdi.fiz-karlsruhe.de/ontology"/>
        <rdfs:label xml:lang="en">Dataset</rdfs:label>
    </owl:owl:Class>


    <!-- https://purls.helmholtz-metadaten.de/rdo/Reference -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/rdo/Reference">
        <owl:equivalentClass rdf:resource="https://www.niso.org/standards-committees/ssos/ssos01.owl#Reference"/>
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/ontology/Resource"/>
        <obo:IAO_0000115 xml:lang="en">Citation to another standard, part of a standard, or other material.</obo:IAO_0000115>
         <rdfs:isDefinedBy>NISO</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Reference</rdfs:label>
    </owl:Class>
    
 <!-- https://purls.helmholtz-metadaten.de/rdo/ReferenceMaterial -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/rdo/ReferenceMaterial">
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/mwo/Material"/>
        <owl:equivalentClass rdf:resource="http://purl.obolibrary.org/obo/CHMO_0002913"/>
        <obo:IAO_0000115 xml:lang="en">Material, sufficiently homogeneous and stable with respect to one or more specified properties, which has been established to be fit for its intended use in a measurement process.</obo:IAO_0000115>
        <rdfs:comment xml:lang="en">Properties can be quantitative or qualitative, e.g. identity of substances or species. Uses may include the calibration of a measurement system, assessment of a measurement procedure, assigning values to other materials, and quality control.</rdfs:comment>
        <rdfs:isDefinedBy>DIN EN ISO 17034:2017</rdfs:isDefinedBy>
        <rdfs:label xml:lang="de">Reference material</rdfs:label>
    </owl:Class>

    <!-- https://purls.helmholtz-metadaten.de/rdo/BibliographicReference -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/rdo/BibliographicReference">
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/rdo/Reference"/>
        <owl:equivalentClass rdf:resource="http://purl.org/spar/biro/BibliographicReference"/>
        <obo:IAO_0000115 xml:lang="en">An expression of a bibliographic record in a specific format, that references a particular textual or data publication (or a work in preparation for publication). Each bibliographic reference is a list of items containing entities that describe aspects of the referenced work - for example authors, title, journal, publication year - selected from the bibliographic record. Note that because different journal styles may require omission of elements of the bibliographic record in references included in a paper&apos;s reference list (e.g. the title, the identifier, the names of the eighth and subsequent authors), and because errors can be introduced when an author creates a bibliographic reference, the bibliographic reference to a published work may not be a complete or fully accurate expression of the information contained within the authoritative bibliographic record for that work.</obo:IAO_0000115>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/biro"/>
        <rdfs:label xml:lang="en">Bibliographic reference</rdfs:label>
    </owl:Class>
    
    <!-- https://purls.helmholtz-metadaten.de/rdo/certifiedReferenceMaterial -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/rdo/certifiedReferenceMaterial">
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/rdo/ReferenceMaterial"/>
        <obo:IAO_0000115 xml:lang="en"> 1) Reference material accompanied by documentation issued by an authoritative body and providing one or more specified property values with associated uncertainties and traceabilities, using valid procedures. 2) Reference material characterized by a metrologically valid procedure for one or more specified properties, accompanied by a reference material certificate that provides the value of the specified property, its associated uncertainty, and a statement of metrological traceability.</obo:IAO_0000115>
        <rdfs:comment xml:lang="en">The concept of value includes a nominal property or a qualitative attribute such as identity or sequence. Uncertainties for such attributes may be expressed as probabilities or levels of confidence.</rdfs:comment>
        <rdfs:isDefinedBy>1) ISO/IEC Guide 99: 2007, 2) ISO Guide 30:2015</rdfs:isDefinedBy>
        <owl:equivalentClass rdf:resource="http://purl.obolibrary.org/obo/CHMO_0002879"/>
        <rdfs:label xml:lang="en">Certified reference material</rdfs:label>
    </owl:Class>


      <!-- https://purls.helmholtz-metadaten.de/rdo/Standard -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/rdo/Standard">
        <obo:IAO_0000115 xml:lang="en">A documented instance of rules, guidelines, or characteristics for activities and/or their results, established by consensus and approved by a recognized body, aimed at the achievement of the optimum degree of order in a given context. Note 1: All instances identified by the same standard’s designation are often referred to as a standards’ family. Source: NISO SSOS WG adapting definitions of pre-existing standards</obo:IAO_0000115>
         <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/ontology/Specification"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
         <owl:equivalentClass rdf:resource="https://www.niso.org/standards-committees/ssos/ssos01.owl#Standard"/>
         <owl:equivalentClass rdf:resource="https://purls.helmholtz-metadaten.de/rdo/Norm"/>
        <rdfs:isDefinedBy>NISO SSOS WG adapting definitions of pre-existing standards</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Standard</rdfs:label>
    </owl:Class>

        <!-- https://purls.helmholtz-metadaten.de/rdo/Norm -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/rdo/Norm">
        <obo:IAO_0000115 xml:lang="en">Document established by consensus and approved by a recognized body, that provides, for common and repeated use, rules, guidelines or characteristics for activities or their results, aimed at the achievement of the optimum degree of order in a given context</obo:IAO_0000115>
        <rdfs:isDefinedBy>SO/IEC Guide 2:2004</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Norm</rdfs:label>
    </owl:Class>
    
   
        <!-- https://purls.helmholtz-metadaten.de/rdo/MeasurementStandard -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/rdo/MeasurementStandard">
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/rdo/Standard"/>
        <obo:IAO_0000115 xml:lang="en">Realization of the definition of a given quantity, with stated quantity value and associated measurement uncertainty, used as a reference:<obo:IAO_0000115>
        <rdfs:isDefinedBy>ISO/IEC Guide 99: 2007</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Measurement standard</rdfs:label>
    </owl:Class>

    <!-- https://purls.helmholtz-metadaten.de/rdo/Certificate -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/rdo/Certificate">
        <rdfs:subClassOf rdf:resource="http://nfdi.fiz-karlsruhe.de/ontology/Specification"/>
        <owl:equivalentClass rdf:resource="http://www.ontologyrepository.com/CommonCoreOntologies/Certificate">
        <obo:IAO_0000115 xml:lang="en"> An Information Bearing Artifact that bears an Information Content Entity which attests to certain demonstrated characteristics of an Object, Person, or Organization.</obo:IAO_0000115>
        <rdfs:isDefinedBy rdf:resource="http://www.ontologyrepository.com/CommonCoreOntologies/Certificate"/>
        <rdfs:label xml:lang="en">Certificate</rdfs:label>
    </owl:Class>
    

    
    
    <!-- https://purls.helmholtz-metadaten.de/rdo/Documentation -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/rdo/Documentation">
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/ontology/Specification"/>
        <obo:IAO_0000115 xml:lang="en">Documentation is any communicable material that is used to describe, explain or instruct regarding some attributes of an object, system or procedure, such as its parts, assembly, installation, maintenance and use</obo:IAO_0000115>
         <owl:equivalentClass rdf:resource="http://purls.helmholtz-metadaten.de/mwo/Documentation"/>
        <rdfs:label xml:lang="en">Documentation</rdfs:label>
    </owl:Class>

    
    <!-- https://purls.helmholtz-metadaten.de/rdo/Licence -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/rdo/Licence">
     <obo:IAO_0000115 xml:lang="en"> A legal document giving official permission to do something with the resource.</obo:IAO_0000115>
        <rdfs:comment>An information content entity that refers to a legal instrument (usually by way of contract law, with or without printed material) governing the use or redistribution of the resource containing the licence.</rdfs:comment>
         <owl:equivalentClass rdf:resource="https://nfdi.fiz-karlsruhe.de/ontology/License"/>
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/ontology/Resource"/>
         <rdfs:isDefinedBy rdf:resource="http://purl.org/dc/terms/license"/>
         <skos:example xml:lang="en">Creative Commons license</skos:example>
        <rdfs:label xml:lang="en">Licence</rdfs:label>
    </owl:Class>
    
   <!-- https://purls.helmholtz-metadaten.de/rdo/Metadata -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/rdo/Metadata">
        <owl:equivalentClass rdf:resource="https://materialdigital.github.io/core-ontology/index-en.html#Metadata"/>
         <obo:IAO_0000115 xml:lang="en">Attributes and additional data concerning the manufacturing of the tested material, test set-up, test system (measuring and test equipment), and the test piece, which allow for the evaluation of the quality/reliability of the measurements and a systematic search task of a database.</obo:IAO_0000115>
        <rdfs:subClassOf rdf:resource=" https://w3id.org/pmd/co/DataScope"/>
         <rdfs:isDefinedBy>NFDI-MatWerk-IUC02</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Metadata</rdfs:label>
    </owl:Class>
    
        <!-- https://purls.helmholtz-metadaten.de/rdo/PrimaryData -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/rdoc/PrimaryData">
        <owl:equivalentClass rdf:resource="https://w3id.org/pmd/co/PrimaryData"/>
         <obo:IAO_0000115 xml:lang="en">Data directly acquired by sensors or measuring instruments during or after an experiment or simulation.</obo:IAO_0000115>
        <rdfs:subClassOf rdf:resource=" https://w3id.org/pmd/co/DataScope"/>
         <rdfs:isDefinedBy>NFDI-MatWerk-IUC02</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Primary data</rdfs:label>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/rdo/SecondaryData -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/rdo/secondaryData">
         <owl:equivalentClass rdf:resource="https://w3id.org/pmd/co/PrimaryData"/>
         <obo:IAO_0000115 xml:lang="en">Data determined by equations or algorithms using primary data and/or metadata.</obo:IAO_0000115>
        <rdfs:subClassOf rdf:resource=" https://w3id.org/pmd/co/DataScope"/>
         <rdfs:isDefinedBy>NFDI-MatWerk-IUC02</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Secondary data</rdfs:label>
    </owl:Class>

    <!-- https://purls.helmholtz-metadaten.de/rdo/Material -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/rdo/Matirial">
    <owl:equivalentClass rdf:resource="http://purls.helmholtz-metadaten.de/mwo/Material"/>
        <rdfs:label>Material</rdfs:label>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/rdo/MatirialDescription -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/rdo/MatirialDescription">
    <obo:IAO_0000115 xml:lang="en">This information is used to qualitatively and quantitatively describe a material by providing information on e.g. material properties, material structure, etc.</obo:IAO_0000115>
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/ontology/Specification"/>   
         <owl:equivalentClass rdf:resource="https://w3id.org/pmd/co/MaterialRelated"/>
        <rdfs:label>Matirial description</rdfs:label>
    </owl:Class>
    





 <!-- https://nfdi.fiz-karlsruhe.de/ontology/Specification -->


    <owl:owl:Class rdf:about="https://nfdi.fiz-karlsruhe.de/ontology/Specification">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/IAO_0000104"/>
                    <rdf:Description rdf:about="https://nfdi.fiz-karlsruhe.de/ontology/CreativeWork"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A creative work that defines the requirements, characteristics, or standards for the design, implementation, or operation of a system, product, or process.</obo:IAO_0000115>
        <rdfs:comment xml:lang="en">A set of requirements, guidelines, standards contributed by an organization or a person.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://nfdi.fiz-karlsruhe.de/ontology"/>
        <rdfs:label xml:lang="en">specification</rdfs:label>
    </owl:Class>
    


 

 <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://nfdi.fiz-karlsruhe.de/ontology/url -->


    <owl:DatatypeProperty rdf:about="http://nfdi.fiz-karlsruhe.de/ontology/url">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment xml:lang="en">URL of a thing.</rdfs:comment>
        <rdfs:label xml:lang="en">url</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/dc/terms/title -->


    <owl:DatatypeProperty rdf:about="http://purl.org/dc/terms/title">
        <rdfs:domain rdf:resource="http://nfdi.fiz-karlsruhe.de/ontology/Resource"/>
    </owl:DatatypeProperty>
    


    <!-- http://purls.helmholtz-metadaten.de/mwo/description -->


    <owl:DatatypeProperty rdf:about="http://purls.helmholtz-metadaten.de/mwo/description">
        <obo:IAO_0000115 xml:lang="en">A data property linking an entity to its description.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">description</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purls.helmholtz-metadaten.de/mwo/hasDOI -->


    <owl:DatatypeProperty rdf:about="http://purls.helmholtz-metadaten.de/mwo/hasDOI">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/identifier"/>
        <rdfs:domain rdf:resource="http://nfdi.fiz-karlsruhe.de/ontology/Resource"/>
        <obo:IAO_0000115 xml:lang="en">A data property relating a work to its Digital Object Identifier (DOI).</obo:IAO_0000115>
        <rdfs:label>has DOI</rdfs:label>
    </owl:DatatypeProperty>



    <!-- http://purls.helmholtz-metadaten.de/mwo/hasProjectIdentifier -->


    <owl:DatatypeProperty rdf:about="http://purls.helmholtz-metadaten.de/mwo/hasProjectIdentifier">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/identifier"/>
        <rdfs:domain rdf:resource="http://nfdi.fiz-karlsruhe.de/ontology/Project"/>
        <obo:IAO_0000115 xml:lang="en">A data property relating a research project with a unique identifier, defined in a given context.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">has project identifier</rdfs:label>
    </owl:DatatypeProperty>
    



    <!-- http://purls.helmholtz-metadaten.de/mwo/hasSerialNumber -->


    <owl:DatatypeProperty rdf:about="http://purls.helmholtz-metadaten.de/mwo/hasSerialNumber">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/identifier"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://schema.org/Product"/>
                    <rdf:Description rdf:about="https://w3id.org/skgo/modsci#Instrument"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:comment xml:lang="en">A data property linking something, for example a piece of equipment, to its serial number.</rdfs:comment>
        <rdfs:label xml:lang="en">has serial number</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purls.helmholtz-metadaten.de/mwo/hasVersion -->


    <owl:DatatypeProperty rdf:about="http://purls.helmholtz-metadaten.de/mwo/hasVersion">
        <rdfs:domain rdf:resource="http://nfdi.fiz-karlsruhe.de/ontology/Resource"/>
        <obo:IAO_0000115 xml:lang="en">A number or string that identifies different variants or releases of a resource.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">has version</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purls.helmholtz-metadaten.de/mwo/instrumentModel -->


    <owl:DatatypeProperty rdf:about="http://purls.helmholtz-metadaten.de/mwo/instrumentModel">
        <rdfs:domain rdf:resource="https://w3id.org/skgo/modsci#Instrument"/>
        <obo:IAO_0000115 xml:lang="en">A data property relating an instrument with the model information.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">instrument model</rdfs:label>
    </owl:DatatypeProperty>
    


    


    <!-- http://xmlns.com/foaf/0.1/firstName -->


    <owl:DatatypeProperty rdf:about="http://xmlns.com/foaf/0.1/firstName">
        <rdfs:subPropertyOf rdf:resource="http://purls.helmholtz-metadaten.de/mwo/hasPersonalInformation"/>
        <rdfs:domain rdf:resource="http://nfdi.fiz-karlsruhe.de/ontology/Person"/>
    </owl:DatatypeProperty>
    


    <!-- http://xmlns.com/foaf/0.1/surname -->


    <owl:DatatypeProperty rdf:about="http://xmlns.com/foaf/0.1/surname">
        <rdfs:subPropertyOf rdf:resource="http://purls.helmholtz-metadaten.de/mwo/hasPersonalInformation"/>
        <rdfs:domain rdf:resource="http://nfdi.fiz-karlsruhe.de/ontology/Person"/>
    </owl:DatatypeProperty>
    


    <!-- http://xmlns.com/foaf/0.1/title -->


    <owl:DatatypeProperty rdf:about="http://xmlns.com/foaf/0.1/title">
        <rdfs:subPropertyOf rdf:resource="http://purls.helmholtz-metadaten.de/mwo/hasPersonalInformation"/>
        <rdfs:domain rdf:resource="http://nfdi.fiz-karlsruhe.de/ontology/Person"/>
        <rdfs:comment>Title (Mr, Mrs, Ms, Dr. etc)</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://xmlns.com/foaf/0.1/"/>
        <rdfs:label>title</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://schema.org/dateCreated -->


    <owl:DatatypeProperty rdf:about="https://schema.org/dateCreated">
        <rdfs:domain rdf:resource="http://nfdi.fiz-karlsruhe.de/ontology/Resource"/>
        <rdfs:comment xml:lang="en">The date on which the CreativeWork was created or the item was added to a DataFeed.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://schema.org/dateCreated"/>
        <rdfs:label xml:lang="en">dateCreated</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://schema.org/datePublished -->


    <owl:DatatypeProperty rdf:about="https://schema.org/datePublished">
        <rdfs:domain rdf:resource="http://nfdi.fiz-karlsruhe.de/ontology/Resource"/>
        <rdfs:comment xml:lang="en">Date of first broadcast/publication.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://schema.org/datePublished"/>
        <rdfs:label xml:lang="en">datePublished</rdfs:label>
    </owl:DatatypeProperty>
    

    <!-- https://schema.org/startTime -->


    <owl:DatatypeProperty rdf:about="https://schema.org/startTime">
        <rdfs:domain rdf:resource="TestOrder"/>
        <rdfs:comment xml:lang="en">The startTime of something. For a reserved event or service (eg FoodEstablishmentReservation), the time that it is expected to start.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://schema.org/startTime"/>
        <rdfs:label xml:lang="en">startTime</rdfs:label>
    </owl:DatatypeProperty>

   
    


    <!-- https://w3id.org/scholarlydata/ontology/conference-ontology.owl#duration -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/scholarlydata/ontology/conference-ontology.owl#duration">
        <rdfs:domain rdf:resource="https://w3id.org/scholarlydata/ontology/conference-ontology.owl#OrganisedEvent"/>
