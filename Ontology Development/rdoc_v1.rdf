    <!--  https://purls.helmholtz-metadaten.de/rdoc/dateOfTestStart -->


    <owl:DataTypeProperty rdf:about=" https://purls.helmholtz-metadaten.de/rdoc/dateOfTestStart">
        <rdfs:domain rdf:resource="https://purls.helmholtz-metadaten.de/rdoc/TestJob">
        <obo:IAO_0000115 xml:lang="en">Date and time on which the test started.<obo:IAO_0000115>
        <rdfs:label xml:lang="en"> date of test start"</rdfs:label>
    </owl:DataTypeProperty>
    

  <!--  https://purls.helmholtz-metadaten.de/rdoc/dateOfTestEnd -->


    <owl:DataTypeProperty rdf:about=" https://purls.helmholtz-metadaten.de/rdoc/dateOfTestEnd">
        <rdfs:domain rdf:resource="https://purls.helmholtz-metadaten.de/rdoc/TestJob">
        <obo:IAO_0000115 xml:lang="en"> Date and time on which the test has finished.<obo:IAO_0000115>
        <rdfs:label xml:lang="en"> date of test end"</rdfs:label>
    </owl:DataTypeProperty>
    

    <!-- https://purls.helmholtz-metadaten.de/rdoc/testID -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/rdoc/testID ">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/identifier"/>
        <rdfs:domain rdf:resource="https://purls.helmholtz-metadaten.de/rdoc/TestJob">
        <obo:IAO_0000115 xml:lang="en">Unique designation (alphanumeric code, name, or other unique designations) assigned to the creep test for identification purposes.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">test identifier</rdfs:label>
    </owl:DatatypeProperty>


 <!-- https://purls.helmholtz-metadaten.de/rdoc/testStandardApplied -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/rdoc/testStandardApplied ">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean">
         <rdfs:domain rdf:resource="https://purls.helmholtz-metadaten.de/rdoc/TestStandard">
        <obo:IAO_0000115 xml:lang="en">Specifies if the test was performed according to a  measurement or test standard, bolean (Yes/No).</obo:IAO_0000115>
        <rdfs:label xml:lang="en">was a test standard applied ?</rdfs:label>
    </owl:DatatypeProperty>





 <!-- https://purls.helmholtz-metadaten.de/rdoc/hasSpecifiedNumericValue -->

    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/rdoc/hasSpecifiedNumericValue">
        <owl:equivalentProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0001937">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0002135"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/OBI_0001933"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float">
        <obo:IAO_0000115 xml:lang="en">A relation between a value specification and a number that quantifies it.</obo:IAO_0000115>
        <rdfs:label>has specified numeric value</rdfs:label>
    </owl:DatatypeProperty>




    <!-- http://purl.obolibrary.org/obo/OBI_0002135 -->

    <owl:DatatypeProperty rdf:about="http://purl.obolibrary.org/obo/OBI_0002135">
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/OBI_0001933"/>
        <obo:IAO_0000111 xml:lang="en">has specified value</obo:IAO_0000111>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000123"/>
        <obo:IAO_0000115 xml:lang="en">A relation between a value specification and a literal.</obo:IAO_0000115>
        <obo:IAO_0000116>This is not an RDF/OWL object property. It is intended to link a value found in e.g. a database column of &apos;M&apos; (the literal) to an instance of a value specification class, which can then be linked to indicate that this is about the biological gender of a human subject.</obo:IAO_0000116>
        <obo:IAO_0000119>OBI</obo:IAO_0000119>
        <rdfs:label xml:lang="en">has specified value</rdfs:label>
    </owl:DatatypeProperty>


<!-- https://purls.helmholtz-metadaten.de/rdo/digitalMaterialIdentifier -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/rdo/digitalMaterialIdentifier">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/identifier"/>
        <rdfs:domain rdf:resource="http://nfdi.fiz-karlsruhe.de/ontology/Resource"/>
        <rdfs:range rdf:resource="https://purls.helmholtz-metadaten.de/rdo/Material"/>
        <obo:IAO_0000115 xml:lang="en">The Digital Material Identifier value object refers to a dmi:DigitalMaterialIdentifier.
A dmi:DigitalMaterialIdentifier is a resource identifier (IRI) that represents the specification of a material (in the sense of a material class) described in a specification document. The specification document can be, e.g., a standard, a datasheet, or any other citable document. Typically, a specification document requires some qualities that a material (in the sense of a portion of matter) has to comply with. Typical requirements include chemical compositions or physical properties.</obo:IAO_0000115>
        <rdfs:label>digital material identifier</rdfs:label>
    </owl:DatatypeProperty>



    <!-- http://nfdi.fiz-karlsruhe.de/ontology/url -->


    <owl:DatatypeProperty rdf:about="http://nfdi.fiz-karlsruhe.de/ontology/url">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment xml:lang="en">URL of a thing.</rdfs:comment>
        <rdfs:label xml:lang="en">url</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/dc/terms/title -->


    <owl:DatatypeProperty rdf:about="http://purl.org/dc/terms/title">
        <rdfs:domain rdf:resource="http://nfdi.fiz-karlsruhe.de/ontology/Resource"/>
    </owl:DatatypeProperty>
    


    <!-- http://purls.helmholtz-metadaten.de/mwo/description -->


    <owl:DatatypeProperty rdf:about="http://purls.helmholtz-metadaten.de/mwo/description">
        <obo:IAO_0000115 xml:lang="en">A data property linking an entity to its description.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">description</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purls.helmholtz-metadaten.de/mwo/hasDOI -->


    <owl:DatatypeProperty rdf:about="http://purls.helmholtz-metadaten.de/mwo/hasDOI">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/identifier"/>
        <rdfs:domain rdf:resource="http://nfdi.fiz-karlsruhe.de/ontology/Resource"/>
        <obo:IAO_0000115 xml:lang="en">A data property relating a work to its Digital Object Identifier (DOI).</obo:IAO_0000115>
        <rdfs:label>has DOI</rdfs:label>
    </owl:DatatypeProperty>



    <!-- http://purls.helmholtz-metadaten.de/mwo/hasProjectIdentifier -->


    <owl:DatatypeProperty rdf:about="http://purls.helmholtz-metadaten.de/mwo/hasProjectIdentifier">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/identifier"/>
        <rdfs:domain rdf:resource="http://nfdi.fiz-karlsruhe.de/ontology/Project"/>
        <obo:IAO_0000115 xml:lang="en">A data property relating a research project with a unique identifier, defined in a given context.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">has project identifier</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purls.helmholtz-metadaten.de/mwo/hasSerialNumber -->


    <owl:DatatypeProperty rdf:about="http://purls.helmholtz-metadaten.de/mwo/hasSerialNumber">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/identifier"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://schema.org/Product"/>
                    <rdf:Description rdf:about="https://w3id.org/skgo/modsci#Instrument"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:comment xml:lang="en">A data property linking something, for example a piece of equipment, to its serial number.</rdfs:comment>
        <rdfs:label xml:lang="en">has serial number</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purls.helmholtz-metadaten.de/mwo/hasVersion -->


    <owl:DatatypeProperty rdf:about="http://purls.helmholtz-metadaten.de/mwo/hasVersion">
        <rdfs:domain rdf:resource="http://nfdi.fiz-karlsruhe.de/ontology/Resource"/>
        <obo:IAO_0000115 xml:lang="en">A number or string that identifies different variants or releases of a resource.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">has version</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purls.helmholtz-metadaten.de/mwo/instrumentModel -->


    <owl:DatatypeProperty rdf:about="http://purls.helmholtz-metadaten.de/mwo/instrumentModel">
        <rdfs:domain rdf:resource="https://w3id.org/skgo/modsci#Instrument"/>
        <obo:IAO_0000115 xml:lang="en">A data property relating an instrument with the model information.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">instrument model</rdfs:label>
    </owl:DatatypeProperty>
    


    


    <!-- http://xmlns.com/foaf/0.1/firstName -->


    <owl:DatatypeProperty rdf:about="http://xmlns.com/foaf/0.1/firstName">
        <rdfs:subPropertyOf rdf:resource="http://purls.helmholtz-metadaten.de/mwo/hasPersonalInformation"/>
        <rdfs:domain rdf:resource="http://nfdi.fiz-karlsruhe.de/ontology/Person"/>
    </owl:DatatypeProperty>
    


    <!-- http://xmlns.com/foaf/0.1/surname -->


    <owl:DatatypeProperty rdf:about="http://xmlns.com/foaf/0.1/surname">
        <rdfs:subPropertyOf rdf:resource="http://purls.helmholtz-metadaten.de/mwo/hasPersonalInformation"/>
        <rdfs:domain rdf:resource="http://nfdi.fiz-karlsruhe.de/ontology/Person"/>
    </owl:DatatypeProperty>
    


    <!-- http://xmlns.com/foaf/0.1/title -->


    <owl:DatatypeProperty rdf:about="http://xmlns.com/foaf/0.1/title">
        <rdfs:subPropertyOf rdf:resource="http://purls.helmholtz-metadaten.de/mwo/hasPersonalInformation"/>
        <rdfs:domain rdf:resource="http://nfdi.fiz-karlsruhe.de/ontology/Person"/>
        <rdfs:comment>Title (Mr, Mrs, Ms, Dr. etc)</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://xmlns.com/foaf/0.1/"/>
        <rdfs:label>title</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://schema.org/dateCreated -->


    <owl:DatatypeProperty rdf:about="https://schema.org/dateCreated">
        <rdfs:domain rdf:resource="http://nfdi.fiz-karlsruhe.de/ontology/Resource"/>
        <rdfs:comment xml:lang="en">The date on which the CreativeWork was created or the item was added to a DataFeed.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://schema.org/dateCreated"/>
        <rdfs:label xml:lang="en">dateCreated</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://schema.org/datePublished -->


    <owl:DatatypeProperty rdf:about="https://schema.org/datePublished">
        <rdfs:domain rdf:resource="http://nfdi.fiz-karlsruhe.de/ontology/Resource"/>
        <rdfs:comment xml:lang="en">Date of first broadcast/publication.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://schema.org/datePublished"/>
        <rdfs:label xml:lang="en">datePublished</rdfs:label>
    </owl:DatatypeProperty>
    

    <!-- https://schema.org/startTime -->


    <owl:DatatypeProperty rdf:about="https://schema.org/startTime">
        <rdfs:domain rdf:resource="https://purls.helmholtz-metadaten.de/rdoc/TestJob"/>
        <rdfs:comment xml:lang="en">The startTime of something. For a reserved event or service (eg FoodEstablishmentReservation), the time that it is expected to start.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://schema.org/startTime"/>
        <rdfs:label xml:lang="en">startTime</rdfs:label>
    </owl:DatatypeProperty>

   
    
    <!-- https://w3id.org/scholarlydata/ontology/conference-ontology.owl#duration -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/scholarlydata/ontology/conference-ontology.owl#duration">
        <rdfs:domain rdf:resource="https://w3id.org/scholarlydata/ontology/conference-ontology.owl#OrganisedEvent"/>
        <rdfs:comment xml:lang="en">duration</rdfs:comment>
        <rdfs:label xml:lang="en">duration</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/scholarlydata/ontology/conference-ontology.owl#endDate -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/scholarlydata/ontology/conference-ontology.owl#endDate">
        <rdfs:domain rdf:resource="https://w3id.org/scholarlydata/ontology/conference-ontology.owl#OrganisedEvent"/>
        <rdfs:comment xml:lang="en">end date</rdfs:comment>
        <rdfs:label xml:lang="en">end date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/scholarlydata/ontology/conference-ontology.owl#startDate -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/scholarlydata/ontology/conference-ontology.owl#startDate">
        <rdfs:domain rdf:resource="https://w3id.org/scholarlydata/ontology/conference-ontology.owl#OrganisedEvent"/>
        <rdfs:comment xml:lang="en">start date</rdfs:comment>
        <rdfs:label xml:lang="en">start date</rdfs:label>
    </owl:DatatypeProperty>
    







