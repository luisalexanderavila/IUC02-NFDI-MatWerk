 <!-- https://purls.helmholtz-metadaten.de/rdoc/hasUnit -->


    <owl:ObjectProperty rdf:about="https://purls.helmholtz-metadaten.de/rdoc/hasUnit ">
    	<owl:equivalentProperty rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/hasUnit">
        <owl:equivalentProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000039">
        <rdfs:range rdf:resource="https://si-digital-framework.org/SI#MeasuremenUnit"/>
        <rdfs:domain rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity">
        <rdfs:label xml:lang="en">has unit</rdfs:label>
    </owl:ObjectProperty>
  
    <!-- https://purls.helmholtz-metadaten.de/rdoc/typeOfLoading -->


    <owl:ObjectProperty rdf:about="https://purls.helmholtz-metadaten.de/rdoc/typeOfLoading">
        <rdfs:range rdf:resource="https://purls.helmholtz-metadaten.de/rdoc/TypeOfLoading"/>
        <obo:IAO_0000115 xml:lang="en">A relation between an instrument and the organization that acts as its owner.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">type of loading</rdfs:label>
    </owl:ObjectProperty>


<!--  https://purls.helmholtz-metadaten.de/rdo/hasDescription  -->

    <owl:ObjectProperty rdf:about=" https://purls.helmholtz-metadaten.de/rdo/hasDescription ">
        <rdfs:equivalentProperty rdf:resource="http://purls.helmholtz-metadaten.de/mwo/description"/>
        <rdfs:domain rdf:resource="http://nfdi.fiz-karlsruhe.de/ontology/Resource"/>
        <obo:IAO_0000115 xml:lang="en">Relation between a resource, e.g. Material and it's description resource, e.g. Material description. </obo:IAO_0000115>
        <rdfs:label xml:lang="en">has description</rdfs:label>
    </owl:ObjectProperty>

    <!--  https://purls.helmholtz-metadaten.de/rdo/issuesCertificate  -->

    <owl:ObjectProperty rdf:about=" https://purls.helmholtz-metadaten.de/rdo/issuesCertificate  ">
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
         <rdfs:range rdf:resource="https://purls.helmholtz-metadaten.de/rdo/Certificate "/>
        <obo:IAO_0000115 xml:lang="en">A general relation linking a certification process to the certificate it produces. </obo:IAO_0000115>
        <rdfs:label xml:lang="en">issues certificate</rdfs:label>
    </owl:ObjectProperty>

<!-- http://purls.helmholtz-metadaten.de/mwo/aboutMaterial -->


    <owl:ObjectProperty rdf:about="http://purls.helmholtz-metadaten.de/mwo/aboutMaterial">
        <rdfs:domain rdf:resource="http://schema.org/CreativeWork"/>
        <rdfs:range rdf:resource="http://purls.helmholtz-metadaten.de/mwo/Material"/>
        <obo:IAO_0000115 xml:lang="en">A relation between a dataset and the material it contains data on.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">about material</rdfs:label>
    </owl:ObjectProperty>


    <!-- http://purls.helmholtz-metadaten.de/mwo/hasOwner -->


    <owl:ObjectProperty rdf:about="http://purls.helmholtz-metadaten.de/mwo/hasOwner">
        <rdfs:domain rdf:resource="https://w3id.org/skgo/modsci#Instrument"/>
        <rdfs:range rdf:resource="http://nfdi.fiz-karlsruhe.de/ontology/Organization"/>
        <obo:IAO_0000115 xml:lang="en">A relation between an instrument and the organization that acts as its owner.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">has owner</rdfs:label>
    </owl:ObjectProperty>
    


     <!-- http://purls.helmholtz-metadaten.de/mwo/hasMember -->


    <owl:ObjectProperty rdf:about="http://purls.helmholtz-metadaten.de/mwo/hasMember">
        <owl:inverseOf rdf:resource="http://purls.helmholtz-metadaten.de/mwo/memberOf"/>
        <rdfs:domain rdf:resource="http://nfdi.fiz-karlsruhe.de/ontology/Project"/>
        <rdfs:range rdf:resource="http://purls.helmholtz-metadaten.de/mwo/ProjectMember"/>
        <obo:IAO_0000115 xml:lang="en">A relation between a research project and its members.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">has member</rdfs:label>
    </owl:ObjectProperty>


