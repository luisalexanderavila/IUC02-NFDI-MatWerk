<?xml version="1.0"?>
<rdf:RDF xmlns="https://purls.helmholtz-metadaten.de/rdoc/"
     xml:base="https://purls.helmholtz-metadaten.de/rdoc/"
     xmlns:co="https://w3id.org/pmd/co/"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:obo="http://purl.obolibrary.org/obo/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:emmo="http://emmo.info/emmo#"
     xmlns:prov="http://www.w3.org/ns/prov#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:oboInOwl="http://www.geneontology.org/formats/oboInOwl#"
     xmlns:ro ="http://purl.obolibrary.org/obo/ro.owl#"
     xmlns:foaf="http://xmlns.com/foaf/0.1/"
     xmlns:mwo="http://purls.helmholtz-metadaten.de/mwo/"
     xmlns:nfdico="http://nfdi.fiz-karlsruhe.de/ontology/"
     xmlns:rdo="https://purls.helmholtz-metadaten.de/rdo/"
     xmlns:om="http://www.ontology-of-units-of-measure.org/resource/om-2/"
     xmlns:si="https://si-digital-framework.org/SI#Constant"

     >
  
 <owl:Ontology rdf:about="">
        <owl:versionIRI rdf:resource="https://purls.helmholtz-metadaten.de/rdoc/1.0.0"/>
        <dc:contributor rdf:resource="https://orcid.org/0000-0001-9560-4728"/>
        <terms:created>2024-15-11</terms:created>
        <terms:creator rdf:resource="https://orcid.org/0000-0001-9560-4728"</terms:creator>
        <terms:description>The Reference Datasets Ontology for Creep (RDOC) represents: i) concepts, which are relevant for the description of a reference dataset, including standard, reference material, documentation, etc. on  a general level, and ii) concepts related specific to creep testing, including the description of metadata (research project, material description, testing parameters, etc.), and primary and secondary data collected during the creep testing. The RDOC will establish a detailed and unified representation of the related terms and with this enable the interoperability and reusability of data, making it also searchable.  The ontology will be used by researchers in the fieled of Materials Science and Engineering (MSE).The purpose of the Reference Dataset Ontology is to describe concepts, which are required to qualify a dataset as a reference dataset. </terms:description>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:title>The Reference Dataset Ontology for Creep data</terms:title>
        <owl:versionInfo>1.0.0</owl:versionInfo>
    </owl:Ontology>
    
 <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    <!-- https://purls.helmholtz-metadaten.de/rdo/ReferenceDataSet -->

    <owl:Class rdf:about="http://purls.helmholtz-metadaten.de/rdo/ReferenceDataSet">
     <owl:equivalentClass rdf:resource="http://purls.helmholtz-metadaten.de/mwo/ReferenceDataset"/>
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/rdo/DataSet"/>
        <obo:IAO_0000115 xml:lang="en">Reference data of materials are - documented according to certain standards as well as - curated (i.e., generated, maintained, preserved, validated) according to certain standards - quantitative data sets (i.e., data + their corresponding metadata) and - have been measured or simulated to a particularly high standard - for a material that has either experienced a well-documented process or is reference material or its composition and structure has been completely characterized. Reference data of materials can also be derived data from reference data. These data are distributed with a license (e.g., GPL) The here addressed standards for documentation, curation and measurement need to be defined for specific materials characteristics (e.g., creep tests) in terms of domain standards. These domain standards are the result of a steered community process. Standards should integrate as much as possible existing standards (e.g., the individual MatWerk domain standards should be as much as possible consistent).</obo:IAO_0000115>
        <rdfs:isDefinedBy>NFDI-MatWerk-IUC02</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Reference dataset</rdfs:label>
    </owl:Class>
    

    <!-- https://purls.helmholtz-metadaten.de/rdo/Reference -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/rdo/Reference">
        <owl:equivalentClass rdf:resource="https://www.niso.org/standards-committees/ssos/ssos01.owl#Reference"/>
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/ontology/Resource"/>
        <obo:IAO_0000115 xml:lang="en">Citation to another standard, part of a standard, or other material.</obo:IAO_0000115>
         <rdfs:isDefinedBy>NISO</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Reference</rdfs:label>
    </owl:Class>
  
<!-- https://purls.helmholtz-metadaten.de/rdo/ReferenceMaterial -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/rdo/ReferenceMaterial">
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/mwo/Material"/>
        <owl:equivalentClass rdf:resource="http://purl.obolibrary.org/obo/CHMO_0002913"/>
        <obo:IAO_0000115 xml:lang="en">Material, sufficiently homogeneous and stable with respect to one or more specified properties, which has been established to be fit for its intended use in a measurement process.</obo:IAO_0000115>
        <rdfs:comment xml:lang="en">Properties can be quantitative or qualitative, e.g. identity of substances or species. Uses may include the calibration of a measurement system, assessment of a measurement procedure, assigning values to other materials, and quality control.</rdfs:comment>
        <rdfs:isDefinedBy>DIN EN ISO 17034:2017</rdfs:isDefinedBy>
        <rdfs:label xml:lang="de">Reference material</rdfs:label>
    </owl:Class>



    <!-- https://purls.helmholtz-metadaten.de/rdo/DataSet -->


    <owl:owl:Class rdf:about="https://purls.helmholtz-metadaten.de/rdo/ReferenceDataSet">
    <owl:equivalentClass rdf:resource="https://nfdi.fiz-karlsruhe.de/ontology/Dataset"/>
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/ontology/CreativeWork"/>
        <obo:IAO_0000115 xml:lang="en">A creative work that refers to a structured collection of data, organized typically for a specific goal such as analysis, research, or reference.</obo:IAO_0000115>
        <rdfs:comment xml:lang="en">A collection of data that consists of one or more files.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://nfdi.fiz-karlsruhe.de/ontology"/>
        <rdfs:label xml:lang="en">Dataset</rdfs:label>
    </owl:owl:Class>

      <!-- https://purls.helmholtz-metadaten.de/rdo/Standard -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/rdo/Standard">
        <obo:IAO_0000115 xml:lang="en">A documented instance of rules, guidelines, or characteristics for activities and/or their results, established by consensus and approved by a recognized body, aimed at the achievement of the optimum degree of order in a given context. Note 1: All instances identified by the same standard’s designation are often referred to as a standards’ family. Source: NISO SSOS WG adapting definitions of pre-existing standards</obo:IAO_0000115>
         <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/ontology/Specification"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
         <owl:equivalentClass rdf:resource="https://www.niso.org/standards-committees/ssos/ssos01.owl#Standard"/>
         <owl:equivalentClass rdf:resource="https://purls.helmholtz-metadaten.de/rdo/Norm"/>
        <rdfs:isDefinedBy>NISO SSOS WG adapting definitions of pre-existing standards</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Standard</rdfs:label>
    </owl:Class>

        <!-- https://purls.helmholtz-metadaten.de/rdo/Norm -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/rdo/Norm">
        <obo:IAO_0000115 xml:lang="en">Document established by consensus and approved by a recognized body, that provides, for common and repeated use, rules, guidelines or characteristics for activities or their results, aimed at the achievement of the optimum degree of order in a given context</obo:IAO_0000115>
        <rdfs:isDefinedBy>SO/IEC Guide 2:2004</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Norm</rdfs:label>
    </owl:Class>
    



    <!-- https://purls.helmholtz-metadaten.de/rdo/MeasurementStandard -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/rdo/MeasurementStandard">
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/rdo/Standard"/>
        <owl:equivalentClass rdf:resource="https://purls.helmholtz-metadaten.de/rdoc/TestStandard"/>
        <obo:IAO_0000115 xml:lang="en">Realization of the definition of a given quantity, with stated quantity value and associated measurement uncertainty, used as a reference.<obo:IAO_0000115>
        <rdfs:isDefinedBy>ISO/IEC Guide 99: 2007</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Measurement standard</rdfs:label>
    </owl:Class>


     <!-- https://purls.helmholtz-metadaten.de/rdoc/TestStandard -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/rdo/TestStandard">
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/rdo/Standard"/>
        <owl:equivalentClass rdf:resource="https://purls.helmholtz-metadaten.de/rdo/MeasurementStandard"/>
        <obo:IAO_0000115 xml:lang="en">Realization of the definition of a given quantity, with stated quantity value and associated measurement uncertainty, used as a reference:<obo:IAO_0000115>
        <rdfs:isDefinedBy>ISO/IEC Guide 99: 2007</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Measurement standard</rdfs:label>
    </owl:Class>

    <!-- https://purls.helmholtz-metadaten.de/rdo/Certificate -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/rdo/Certificate">
        <rdfs:subClassOf rdf:resource="http://nfdi.fiz-karlsruhe.de/ontology/Specification"/>
        <owl:equivalentClass rdf:resource="http://www.ontologyrepository.com/CommonCoreOntologies/Certificate">
        <obo:IAO_0000115 xml:lang="en"> An Information Bearing Artifact that bears an Information Content Entity which attests to certain demonstrated characteristics of an Object, Person, or Organization.</obo:IAO_0000115>
        <rdfs:isDefinedBy rdf:resource="http://www.ontologyrepository.com/CommonCoreOntologies/Certificate"/>
        <rdfs:label xml:lang="en">Certificate</rdfs:label>
    </owl:Class>
    
    
    <!-- https://purls.helmholtz-metadaten.de/rdo/Documentation -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/rdo/Documentation">
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/ontology/Specification"/>
        <obo:IAO_0000115 xml:lang="en">Documentation is any communicable material that is used to describe, explain or instruct regarding some attributes of an object, system or procedure, such as its parts, assembly, installation, maintenance and use</obo:IAO_0000115>
         <owl:equivalentClass rdf:resource="http://purls.helmholtz-metadaten.de/mwo/Documentation"/>
        <rdfs:label xml:lang="en">Documentation</rdfs:label>
    </owl:Class>

    
    <!-- https://purls.helmholtz-metadaten.de/rdo/Licence -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/rdo/Licence">
     <obo:IAO_0000115 xml:lang="en"> A legal document giving official permission to do something with the resource.</obo:IAO_0000115>
        <rdfs:comment>An information content entity that refers to a legal instrument (usually by way of contract law, with or without printed material) governing the use or redistribution of the resource containing the licence.</rdfs:comment>
         <owl:equivalentClass rdf:resource="https://nfdi.fiz-karlsruhe.de/ontology/License"/>
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/ontology/Resource"/>
         <rdfs:isDefinedBy rdf:resource="http://purl.org/dc/terms/license"/>
         <skos:example xml:lang="en">Creative Commons license</skos:example>
        <rdfs:label xml:lang="en">Licence</rdfs:label>
    </owl:Class>
    
   <!-- https://purls.helmholtz-metadaten.de/rdo/Metadata -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/rdo/Metadata">
        <owl:equivalentClass rdf:resource="https://materialdigital.github.io/core-ontology/index-en.html#Metadata"/>
         <obo:IAO_0000115 xml:lang="en">Attributes and additional data concerning the manufacturing of the tested material, test set-up, test system (measuring and test equipment), and the test piece, which allow for the evaluation of the quality/reliability of the measurements and a systematic search task of a database.</obo:IAO_0000115>
        <rdfs:subClassOf rdf:resource=" https://w3id.org/pmd/co/DataScope"/>
        <owl:disjointWith rdf:resource="https://purls.helmholtz-metadaten.de/rdo/PrimaryData"/>
        <owl:disjointWith rdf:resource="https://purls.helmholtz-metadaten.de/rdo/SecondaryData"/>
         <rdfs:isDefinedBy>NFDI-MatWerk-IUC02</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Metadata</rdfs:label>
    </owl:Class>
    
        <!-- https://purls.helmholtz-metadaten.de/rdo/PrimaryData -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/rdoc/PrimaryData">
        <owl:equivalentClass rdf:resource="https://w3id.org/pmd/co/PrimaryData"/>
         <obo:IAO_0000115 xml:lang="en">Data directly acquired by sensors or measuring instruments during or after an experiment or simulation.</obo:IAO_0000115>
        <rdfs:subClassOf rdf:resource=" https://w3id.org/pmd/co/DataScope"/>
        <owl:disjointWith rdf:resource="https://purls.helmholtz-metadaten.de/rdo/Metaata"/>
        <owl:disjointWith rdf:resource="https://purls.helmholtz-metadaten.de/rdo/SecondaryData"/>
         <rdfs:isDefinedBy>NFDI-MatWerk-IUC02</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Primary data</rdfs:label>
    </owl:Class>
    

    <!-- https://purls.helmholtz-metadaten.de/rdo/SecondaryData -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/rdo/secondaryData">
         <owl:equivalentClass rdf:resource="https://w3id.org/pmd/co/PrimaryData"/>
         <obo:IAO_0000115 xml:lang="en">Data determined by equations or algorithms using primary data and/or metadata.</obo:IAO_0000115>
        <rdfs:subClassOf rdf:resource=" https://w3id.org/pmd/co/DataScope"/>
         <owl:disjointWith rdf:resource="https://purls.helmholtz-metadaten.de/rdo/PrimaryData"/>
        <owl:disjointWith rdf:resource="https://purls.helmholtz-metadaten.de/rdo/Metadata"/>
         <rdfs:isDefinedBy>NFDI-MatWerk-IUC02</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Secondary data</rdfs:label>
    </owl:Class>

    <!-- https://purls.helmholtz-metadaten.de/rdo/Material -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/rdo/Material">
    <owl:equivalentClass rdf:resource="http://purls.helmholtz-metadaten.de/mwo/Material"/>
        <rdfs:label>Material</rdfs:label>
    </owl:Class>
    

    <!-- https://purls.helmholtz-metadaten.de/rdo/MaterialDescription -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/rdo/MaterialDescription">
    <obo:IAO_0000115 xml:lang="en">This information is used to qualitatively and quantitatively describe a material by providing information on e.g. material properties, material structure, etc.</obo:IAO_0000115>
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/ontology/Specification"/>   
         <owl:equivalentClass rdf:resource="https://w3id.org/pmd/co/MaterialRelated"/>
        <rdfs:label>Material description</rdfs:label>
    </owl:Class>
    
        <!-- https://purls.helmholtz-metadaten.de/rdo/DataProcessing -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/rdoc/Data_processing">
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/rdoc/OWLClass_84bc12d6_ecbb_4186_86b1_03059e621ad9"/>
        <rdfs:label>Data processing</rdfs:label>
    </owl:Class>




    <!-- https://purls.helmholtz-metadaten.de/rdoc/TestInfo -->

    <owl:owl:Class rdf:about="https://purls.helmholtz-metadaten.de/rdoc/TestInfo">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000033"/>
        <rdfs:comment>This property is used to formally describe the metadata on the testing process  by providing information such as testdate, test ID, related project and the operator.<rdfs:comment>
        <rdfs:label>Test information</rdfs:label>
    </owl:owl:Class>

    <!-- https://purls.helmholtz-metadaten.de/rdoc/TestJob-->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/rdoc/TestJob"
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000011"/>
        <rdfs:comment>A process that realizes a plan which is the concretization of a plan specification.</rdfs:comment>
        <rdfs:label>Test job </rdfs:label>
    </owl:Class>
    
   <!-- https://purls.helmholtz-metadaten.de/rdoc/TestJobDetails -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/rdoc/TestJobDetails">
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/rdoc/TestInfo"/>
        <rdfs:comment>Test-related administrative information, such as test ID, testing date, related project, etc.</rdfs:comment>
        <rdfs:isDefinedBy>DIN 55350-11:2008</rdfs:isDefinedBy>
        <rdfs:label>Test job details</rdfs:label>
    </owl:Class>
    

 
   <!-- https://purls.helmholtz-metadaten.de/rdoc/AsManufacturedMaterial -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/rdoc/As_manufactured_material">
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/rdoc/Material"/>
        <rdfs:label xml:lang="en">As manufactured material</rdfs:label>
        <obo:IAO_0000115 xml:lang="en">Piece of finite material, manufactured in a specific manner (e.g. casting, additive manufacturing) which can be used for further use (e.g. analysis) or machined to other products/parts/samples (in any form or shape).> </obo:IAO_0000115>
    </owl:Class>



    <!-- https://purls.helmholtz-metadaten.de/rdoc/HistoryAndConditionOfMaterial -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/rdoc/HistoryAndConditionOfMaterial">
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/rdoc/MaterialDescription"/>
        </obo:IAO_0000115>Information related to the material to be tested. It includes manufacturing and heat treatment history, the chemical composition,  description of the microstructure, and other results obtained from destructive or nondestructive characterization techniques.</obo:IAO_0000115>
        <rdfs:label>History and condition of the material</rdfs:label>
    </owl:Class>



    <!-- https://purls.helmholtz-metadaten.de/rdoc/TestedMaterial -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/rdoc/Testedmaterial">
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/rdoc/HistoryAndConditionOfMaterial"/>
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/rdoc/Material"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/MaterialRelated"/>
       </obo:IAO_0000115>The provenance of the as-manufactured material, for instance, chemical composition, heat treatment/condition, and manufacturing-related information, is documented.</obo:IAO_0000115>
        <rdfs:isDefinedBy>https://w3id.org/pmd/co</rdfs:isDefinedBy>
        <rdfs:label>As tested material</rdfs:label>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/rdoc/TestingParameter -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/rdoc/TestingParameter">
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/rdoc/Test_information"/>
       </obo:IAO_0000115>Parameter which have to be defined to achieve the test result. In a creep test under constant force these can be the initial stress and the specified temperature.</obo:IAO_0000115>
        <rdfs:isDefinedBy>ISO 12718:2019(en)</rdfs:isDefinedBy>
        <rdfs:label>Testing parameter</rdfs:label>
    </owl:Class>
    

    <!-- https://purls.helmholtz-metadaten.de/rdoc/SpecifiedTemperature-->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/rdoc/SpecifiedTemperature">
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/rdoc/Test_information"/>
        </obo:IAO_0000115>Specified  temperature for the creep test. It is the target value of the measured temperature during the test.</obo:IAO_0000115>
        <rdfs:isDefinedBy>ISO 12718:2019(en)</rdfs:isDefinedBy>
        <rdfs:label>Specified temperature</rdfs:label>
    </owl:Class>


    <!-- https://purls.helmholtz-metadaten.de/rdoc/TypeOfLoading -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/rdoc/TypeOfLoading ">
      <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/rdoc/TestingParameter"/>
        </obo:IAO_0000115>Type of Loading encompasses various forms of loading that can be applied to materials and structures, including bending, tension, compression, shear, and torsion or mixed types.</obo:IAO_0000115>
        <rdfs:label>Type of loading</rdfs:label>
    </owl:Class>


  <!-- https://purls.helmholtz-metadaten.de/rdoc/InitialStress -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/rdoc/InitialStress ">
      <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/rdoc/TestingParameter"/>
        </obo:IAO_0000115>Specified stress for the creep test. It is the target value of the stress in the test piece at the beginning of the test, after it has been heated up to the specified temperature. In a creep test conducted under constant tensile force, it will change over the test's duration, as the specimen deforms.</obo:IAO_0000115>
        <rdfs:label>Initial stress</rdfs:label>
    </owl:Class>

    <!-- https://purls.helmholtz-metadaten.de/rdoc/AcquisitionRate -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/rdoc/AcquisitionRate">
        <obo:IAO_0000111 rdf:resource="http://www.w3.org/2002/07/owl"/>
        <rdfs:comment>This property denotes the number of measurements / queries per time period for a considered measurement of a measurement parameter (sampling / query rate during data acquisition).</rdfs:comment>
        <rdfs:label xml:lang="en">Acquisition rate</rdfs:label>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/rdoc/ExtensionRangeUpperLimit -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/rdoc/ExtensionRangeUpperLimit">
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/rdoc/extensometer"/>
        <rdfs:label xml:lang="en">Extension range - upper limit</rdfs:label>
    </owl:Class>
    


    


    <!-- https://purls.helmholtz-metadaten.de/rdoc/Preload -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/rdoc/Preload">
        <rdfs:comment xml:lang="en">A load applied to the sample before heating to keep it on position. It can not be more than 10% than the test force. Its objective is to secure the sample during the initial stage of the creep test.</rdfs:comment>
        <rdfs:label xml:lang="en">Preload</rdfs:label>
    </owl:Class>
    
    


    <!-- https://purls.helmholtz-metadaten.de/rdoc/TestResult -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/rdoc/TestResult">
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/rdoc/OWLClass_84bc12d6_ecbb_4186_86b1_03059e621ad9"/>
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/rdoc/PrimaryData"/>
        <rdfs:subClassOf rdf:resource="https://purls.helmholtz-metadaten.de/rdoc/secondaryData"/>
        <rdfs:comment xml:lang="en">Value of a characteristic, obtained by carrying out a specified test method.</rdfs:comment>
        <rdfs:isDefinedBy>ISO 3534-2:2006</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Test result</rdfs:label>
    </owl:Class>
    


    <!-- https://purls.helmholtz-metadaten.de/rdoc/TestingAndMeasurementEquipment -->

    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/rdoc/TestingAndMeasurementEquipment">
