def setup_worktrees(repo_path, worktrees):
    """Set up multiple worktrees for a repository."""
    for worktree in worktrees:
        worktree_path = worktree['path']
        branch = worktree['branch']
        description = worktree.get('description', "No description provided.")

        if os.path.exists(worktree_path):
            logger.info(f"Worktree already exists: {worktree_path} ({branch})")
            continue

        logger.info(f"Adding worktree for branch '{branch}': {worktree_path} - {description}")
        run_command(["git", "worktree", "add", worktree_path, branch], cwd=repo_path)
import shutil


def setup_sparse_checkout(repo_path, old_url, sparse_checkout):
    """Set up a sparse checkout repository."""
    branch = sparse_checkout['branch']
    subfolder = sparse_checkout['path']

    # Check if the branch exists in the remote repository
    logger.info(f"Checking if branch '{branch}' exists in {old_url}...")
    try:
        branches = run_command(["git", "ls-remote", "--heads", old_url])
        if f"refs/heads/{branch}" not in branches:
            raise ValueError(f"Branch '{branch}' does not exist in {old_url}.")
    except subprocess.CalledProcessError as e:
        logger.error(f"Failed to verify branch existence: {e}")
        raise

    logger.info(f"Performing sparse checkout from 'old_remote': {old_url}")
    try:
        # Clone and configure sparse checkout
        run_command(["git", "clone", "--no-checkout", "--depth", "1", "--branch", branch, old_url, repo_path])
        run_command(["git", "remote", "rename", "origin", "old_remote"], cwd=repo_path)
        run_command(["git", "sparse-checkout", "init", "--cone"], cwd=repo_path)
        run_command(["git", "sparse-checkout", "set", subfolder], cwd=repo_path)
        run_command(["git", "checkout"], cwd=repo_path)

        # Move specific files from the sparse subfolder into the root of repo_path
        sparse_folder_path = os.path.join(repo_path, subfolder)
        if os.path.exists(sparse_folder_path):
            for item in os.listdir(sparse_folder_path):
                src = os.path.join(sparse_folder_path, item)
                dest = os.path.join(repo_path, item)
                if os.path.exists(dest):
                    logger.warning(f"Overwriting existing file or directory: {dest}")
                    if os.path.isdir(dest):
                        shutil.rmtree(dest)
                    else:
                        os.remove(dest)
                shutil.move(src, dest)

            # Remove empty parent directories leading to the sparse subfolder
            parent_dir = os.path.dirname(sparse_folder_path)
            while parent_dir != repo_path:
                try:
                    os.rmdir(parent_dir)  # Only removes empty directories
                except OSError:
                    break  # Stop if the directory is not empty
                parent_dir = os.path.dirname(parent_dir)
        else:
            logger.error(f"Sparse folder path does not exist: {sparse_folder_path}")
            raise FileNotFoundError(f"Sparse folder path does not exist: {sparse_folder_path}")

    except subprocess.CalledProcessError as e:
        logger.error(f"Failed to set up sparse checkout: {e}")
        raise

def setup_repository(dep_name, dep_data):
    """Set up the repository, including remotes, sparse checkout, and worktrees."""
    repo_path = dep_data['repo']
    remotes = dep_data.get('remotes', {})
    worktrees = dep_data.get('worktrees', [])

    origin = remotes.get("origin", {}).get("url")
    upstream = remotes.get("upstream", {}).get("url")
    old_remote = remotes.get("old_remote", {})

    if old_remote:
        old_url = old_remote.get('url')
        sparse_checkout = old_remote.get('sparse_checkout')

        if not old_url or not sparse_checkout:
            logger.error(f"Error: 'old_remote' for {dep_name} must include 'url' and 'sparse_checkout'.")
            raise ValueError(f"'old_remote' configuration is incomplete for {dep_name}.")

        setup_sparse_checkout(repo_path, old_url, sparse_checkout)

        if origin:
            logger.info(f"Adding 'origin' remote: {origin}")
            run_command(["git", "remote", "add", "origin", origin], cwd=repo_path)

    elif origin:
        if os.path.exists(repo_path):
            logger.info(f"Repository already exists at {repo_path}. Skipping clone.")
        else:
            logger.info(f"Cloning repository from 'origin': {origin}...")
            run_command(["git", "clone", origin, repo_path])

        if upstream:
            logger.info(f"Adding 'upstream' remote: {upstream}")
            run_command(["git", "remote", "add", "upstream", upstream], cwd=repo_path)

    else:
        logger.error(f"Error: {dep_name} must include either 'origin' or 'old_remote' in remotes.")
        raise ValueError(f"No valid remotes specified for {dep_name}.")

    if worktrees:
        setup_worktrees(repo_path, worktrees)

def setup_dependencies(config_file):
    """Set up all dependencies based on a YAML configuration."""
    if not os.path.exists(config_file):
        logger.error(f"Configuration file not found: {config_file}")
        raise FileNotFoundError(f"Configuration file not found: {config_file}")

    with open(config_file, 'r') as f:
        config = yaml.safe_load(f)

    for dep_name, dep_data in config.get('dependencies', {}).items():
        logger.info(f"Setting up dependency: {dep_name}")
        try:
            setup_repository(dep_name, dep_data)
        except Exception as e:
            logger.exception(f"Failed to set up dependency {dep_name}.")

if __name__ == "__main__":
    CONFIG_FILE = "config/dependencies_config.yaml"
    try:
        setup_dependencies(CONFIG_FILE)
    except Exception as e:
        logger.exception("An error occurred during setup.")

